# IAMGENESIS platform (local dev defaults)
IAMGENESIS_AUTH_URL=https://auth.iamgenesis.ai
IAMGENESIS_API_URL=https://api.iamgenesis.ai

# Optional headless auth (skip OAuth UI in the provider connect flow)
IAMGENESIS_ACCESS_TOKEN=
IAMGENESIS_API_KEY=

# OAuth client secret for Genesis Code token exchange (server-side)
CODE_CLIENT_SECRET=dev-code-secret