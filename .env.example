# IAMGENESIS platform (local dev defaults)
IAMGENESIS_AUTH_URL=https://auth.iamgenesis.ai
IAMGENESIS_API_URL=https://api.iamgenesis.ai

# Optional headless auth (skip OAuth UI in the provider connect flow)
IAMGENESIS_ACCESS_TOKEN=
IAMGENESIS_API_KEY=

# OAuth client secret.
# For the real auth.iamgenesis.ai with client_id=web, set the correct secret registered for that client (only if the server requires it for PKCE+secret).
# The "dev-code-secret" is only for local dev auth servers.
# If set to the wrong value, you get "Invalid client_secret".
# After login the /api/tenants call (to populate selector) uses the resulting access token; if it 401s the selector is skipped and a continue prompt is shown.
# CODE_CLIENT_SECRET=...